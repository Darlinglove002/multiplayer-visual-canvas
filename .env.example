# Copy the relevant block into apps/web/.env.local and apps/sync/.env.
# `npm run setup` writes both for local dev automatically.

# ---------------------------------------------------------------------------
# apps/web  ->  apps/web/.env.local        (local values shown; prod differs)
# ---------------------------------------------------------------------------
# Local docker Postgres is on host port 5433 (not 5432) to avoid clashing with
# any Postgres already on the machine.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/canvas
# WebSocket origin of the sync server (apps/sync). ws:// local, wss:// in prod.
NEXT_PUBLIC_SYNC_URL=ws://localhost:1234
# Optional — without it the AI prompt bar says it isn't set up. https://console.anthropic.com
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# apps/sync  ->  apps/sync/.env
# ---------------------------------------------------------------------------
# DATABASE_URL=postgres://postgres:postgres@localhost:5433/canvas   (same DB as web)
# Hosted Postgres only: the CA certificate as PEM text (Supabase: Database Settings -> SSL).
# DATABASE_CA_CERT=
# Optional spend caps for the AI assistant (defaults shown):
# AI_PER_IP_PER_HOUR=10
# DAILY_AI_CALL_CAP=25
# MONTHLY_AI_CALL_CAP=200
# HOCUSPOCUS_PORT=1234
# NODE_ENV=development
